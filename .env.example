# TORI 공통 환경파일 표준
# .env.example = Git 포함 템플릿 / .env.local = 실제 로컬 값(Git 제외)
# Render 등 배포환경에서는 같은 변수명을 Secret/Environment에 등록합니다.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
OPENAI_VECTOR_STORE_ID=
BLOTORI_RAG_ENABLED=true
BLOTORI_RAG_CATEGORIES=health
BLOTORI_RAG_MAX_RESULTS=6
BLOTORI_KNOWLEDGE_DIR=knowledge-base
BLOTORI_KNOWLEDGE_PROFILE=commercial
