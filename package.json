{
  "name": "blotori-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "knowledge:organize:plan": "node scripts/organize-knowledge-base.mjs",
    "knowledge:organize": "node scripts/organize-knowledge-base.mjs --apply",
    "knowledge:audit": "node scripts/audit-knowledge-base.mjs",
    "knowledge:audit:strict": "node scripts/audit-knowledge-base.mjs --strict",
    "knowledge:plan": "node scripts/audit-knowledge-base.mjs --strict && node scripts/sync-knowledge-base.mjs --dry-run",
    "knowledge:plan:research": "node scripts/audit-knowledge-base.mjs && node scripts/sync-knowledge-base.mjs --dry-run --profile=research",
    "knowledge:sync": "node scripts/audit-knowledge-base.mjs --strict && node scripts/sync-knowledge-base.mjs --profile=commercial",
    "knowledge:sync:research": "node scripts/audit-knowledge-base.mjs && node scripts/sync-knowledge-base.mjs --profile=research",
    "knowledge:append": "node scripts/audit-knowledge-base.mjs --strict && node scripts/sync-knowledge-base.mjs --append --profile=commercial"
  },
  "dependencies": {
    "next": "16.3.4",
    "openai": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
